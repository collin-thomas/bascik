{
  "ci": {
    "collect": {
      "startServerCommand": "bascik --serve",
      "startServerReadyPattern": "Loaded \\d+ pages? from dist/",
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/attribute-inheritance",
        "http://localhost:8080/build-scripts",
        "http://localhost:8080/cli",
        "http://localhost:8080/compatibility",
        "http://localhost:8080/components",
        "http://localhost:8080/configuration",
        "http://localhost:8080/deploying",
        "http://localhost:8080/developer-experience",
        "http://localhost:8080/faq",
        "http://localhost:8080/getting-started",
        "http://localhost:8080/internals",
        "http://localhost:8080/internals/architecture",
        "http://localhost:8080/internals/ci-cd",
        "http://localhost:8080/internals/create-app",
        "http://localhost:8080/internals/diagnostics",
        "http://localhost:8080/internals/minification",
        "http://localhost:8080/internals/scoping-system",
        "http://localhost:8080/internals/server",
        "http://localhost:8080/internals/testing",
        "http://localhost:8080/internals/transpilation-pipeline",
        "http://localhost:8080/libraries",
        "http://localhost:8080/license",
        "http://localhost:8080/performance",
        "http://localhost:8080/props",
        "http://localhost:8080/recipes/markdown",
        "http://localhost:8080/recipes/page-aware-scripts",
        "http://localhost:8080/recipes/server-scripts",
        "http://localhost:8080/recipes/templating",
        "http://localhost:8080/scoped-javascript",
        "http://localhost:8080/scoped-styles",
        "http://localhost:8080/search",
        "http://localhost:8080/server",
        "http://localhost:8080/sitemap",
        "http://localhost:8080/slots",
        "http://localhost:8080/switch",
        "http://localhost:8080/switch/from-astro",
        "http://localhost:8080/switch/from-eleventy",
        "http://localhost:8080/switch/from-hugo",
        "http://localhost:8080/switch/from-next",
        "http://localhost:8080/switch/from-react",
        "http://localhost:8080/switch/from-svelte",
        "http://localhost:8080/switch/from-vue",
        "http://localhost:8080/testing",
        "http://localhost:8080/tools/agent-skill",
        "http://localhost:8080/tools/vscode-extension",
        "http://localhost:8080/using-markdown",
        "http://localhost:8080/vs-frameworks",
        "http://localhost:8080/why-bascik"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertions": {
        "is-crawlable": "off",
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 1.0 }],
        "categories:seo": ["error", { "minScore": 1.0 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
