{
  "ci": {
    "collect": {
      "startServerCommand": "yarn docs:build && node ../pkg/dist/index.js --serve",
      "startServerReadyPattern": "Loaded \\d+ pages? from dist/",
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/getting-started",
        "http://localhost:8080/components",
        "http://localhost:8080/performance",
        "http://localhost:8080/scoped-styles",
        "http://localhost:8080/scoped-javascript",
        "http://localhost:8080/faq"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
