{
  "name": "bascik-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Collin Thomas",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "bascik",
    "build": "bascik --build",
    "e2e": "playwright test --config e2e/playwright.config.ts --reporter=line",
    "pkg-dev": "node --inspect --watch-path=./bascik.config.ts --watch-path=../../pkg/src ../../pkg/src/transpile.ts",
    "generate:llms": "node scripts/generate-llms-txt.ts",
    "generate:search": "node scripts/generate-search-index.ts",
    "test": "vitest run",
    "update-coverage": "vitest run --coverage.enabled && node scripts/update-coverage.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@bascik/bascik": "workspace:*",
    "marked": "^18.0.7"
  }
}
