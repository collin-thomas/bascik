{
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "pkg",
    "create",
    "docs",
    "extensions/vscode-bascik"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "pkg:build": "yarn workspace @bascik/bascik build",
    "pkg:test": "yarn workspace @bascik/bascik test",
    "pkg:test:ci": "yarn workspace @bascik/bascik test:ci",
    "pkg:test:coverage": "yarn workspace @bascik/bascik test:coverage",
    "pkg:typecheck": "yarn workspace @bascik/bascik typecheck",
    "pkg:e2e": "yarn workspace @bascik/bascik e2e",
    "pkg:e2e:dev": "yarn workspace @bascik/bascik e2e:dev",
    "pkg:e2e:prod": "yarn workspace @bascik/bascik e2e:prod",
    "pkg:e2e:prod:http1": "yarn workspace @bascik/bascik e2e:prod:http1",
    "pkg:e2e:prod:http2": "yarn workspace @bascik/bascik e2e:prod:http2",
    "pkg:e2e:all": "yarn pkg:e2e && yarn pkg:e2e:prod",
    "e2e:all": "yarn pkg:e2e && yarn pkg:e2e:prod && yarn docs:e2e",
    "pkg:bench": "yarn workspace @bascik/bascik bench",
    "docs:build": "yarn workspace bascik-docs build",
    "docs:preview": "npx http-server docs/dist",
    "docs:update-coverage": "yarn workspace @bascik/bascik update-coverage",
    "docs:update-e2e-coverage": "yarn workspace @bascik/bascik update-e2e-coverage",
    "create:update-coverage": "yarn workspace create-bascik update-coverage",
    "create:test": "yarn workspace create-bascik test",
    "create:test:ci": "yarn workspace create-bascik test:ci",
    "docs:update-scripts-coverage": "yarn workspace bascik-docs update-coverage",
    "ext:update-coverage": "yarn workspace bascik-vscode update-coverage",
    "update-coverage:all": "yarn docs:update-coverage && yarn docs:update-e2e-coverage && yarn create:update-coverage && yarn ext:update-coverage && yarn docs:update-scripts-coverage",
    "check:spelling": "codespell --builtin \"clear,rare,en-GB_to_en-US\" pkg/src docs/content docs/src create/src",
    "check:standards": "npx hint docs/src/pages",
    "check:all": "yarn check:spelling && yarn check:standards",
    "typecheck:all": "yarn pkg:typecheck && yarn workspace create-bascik typecheck && yarn workspace bascik-vscode compile",
    "test:all": "yarn pkg:test:ci && yarn docs:test && yarn create:test:ci && yarn workspace bascik-vscode test:unit && yarn typecheck:all",
    "docs:dev": "yarn workspace bascik-docs dev",
    "docs:test": "yarn workspace bascik-docs test",
    "docs:e2e": "yarn workspace bascik-docs e2e",
    "create:build": "yarn workspace create-bascik build",
    "create:prepack": "yarn workspace create-bascik prepack",
    "create:test-site": "yarn create:build && node create/dist/index.js my-site -y",
    "ext:compile": "yarn workspace bascik-vscode compile",
    "ext:test": "yarn workspace bascik-vscode test"
  }
}
